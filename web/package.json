{
  "name": "tickwave-web",
  "version": "0.0.0",
  "private": true,
  "description": "tickwave's web elements: the canvas renderer, its interaction, and the custom elements",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.ts && node scripts/site.ts",
    "dev": "node scripts/generate.ts && node build.ts --serve",
    "typecheck": "tsc -p .",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "e2e": "node scripts/generate.ts && playwright test",
    "fixtures": "node scripts/fixtures.ts",
    "vendor": "node scripts/vendor.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "generate": "node scripts/generate.ts",
    "site": "node scripts/site.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-scale": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/send": "^1.2.1",
    "csv-parse": "^7.0.3",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "send": "^1.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "d3-scale": "^4.0.3",
    "lru-cache": "^11.5.3",
    "smol-toml": "^1.9.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
