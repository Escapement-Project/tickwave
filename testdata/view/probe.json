        {"fn":"analog_from_overview","args":{"overview":{"bucket":4,"start":0,"min":[0,0.5,"Infinity"],"max":[0.2,0.9,"-Infinity"]},"t0":8,"t1":12},"expect":{"kind":"none"}}
      ]
