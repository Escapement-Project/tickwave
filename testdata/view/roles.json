    {
      "name": "which role draws each stretch of a row",
      "rows": [
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [], "px0": 0, "px1": 100}, "expect": [[0, 100, null]], "note": "Nothing painted: the trace's own look."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 20, "probe"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 20, "probe"], [20, 100, null]], "note": "One span, end exclusive."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 40, "probe"], [20, 30, "target"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 20, "probe"], [20, 30, "target"], [30, 40, "probe"], [40, 100, null]], "note": "The later in sidecar order draws where both paint."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[20, 30, "target"], [10, 40, "probe"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 40, "probe"], [40, 100, null]], "note": "Listed first, target is under probe throughout, and probe's columns are one stretch, so a dash runs on across them."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 20, "probe"], [20, 30, "target"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 20, "probe"], [20, 30, "target"], [30, 100, null]], "note": "One ends at the column the next begins: nothing between, nothing shared."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 20, "probe"], [20, 30, "probe"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 30, "probe"], [30, 100, null]], "note": "Two spans of one role that meet are one stretch."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 40, "probe"], [20, 30, "handy"]], "px0": 0, "px1": 100}, "expect": [[0, 10, null], [10, 40, "probe"], [40, 100, null]], "note": "A paint naming no declared role draws nothing, though later: probe shows through it."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[10, 20, "handy"]], "px0": 0, "px1": 100}, "expect": [[0, 100, null]], "note": "Alone, its columns are the trace's."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[-5, 10, "target"], [90, 120, "neither"]], "px0": 0, "px1": 100}, "expect": [[0, 10, "target"], [10, 90, null], [90, 100, "neither"]], "note": "Cut to the row's columns at either end."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[100, 120, "probe"], [30, 30, "probe"], [40, 35, "target"]], "px0": 0, "px1": 100}, "expect": [[0, 100, null]], "note": "Past the row, empty, or ending before it starts: nothing."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[0, 100, "neither"], [10, 90, "probe"], [20, 80, "target"]], "px0": 0, "px1": 100}, "expect": [[0, 10, "neither"], [10, 20, "probe"], [20, 80, "target"], [80, 90, "probe"], [90, 100, "neither"]], "note": "Three deep, each later one over the ones before."},
        {"fn": "stretches", "args": {"roles": ["probe", "target", "neither"], "spans": [[40, 55, "probe"]], "px0": 50, "px1": 60}, "expect": [[50, 55, "probe"], [55, 60, null]], "note": "A row's columns from 50."}
      ]
    },
    {
      "name": "where a dash's phase starts: the length of a row's line at a column",
      "rows": [
        {"fn": "length_at", "args": {"paths": [[0, 0, 10, 10, 10, 15, 30, 35]], "x": 5}, "expect": 5, "note": "Along a level 10 long: 5."},
