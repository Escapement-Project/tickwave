        {"fn": "length_at", "args": {"paths": [[0, 0, 10, 10, 10, 15, 30, 35]], "x": 20}, "expect": 25, "note": "15 at the edge's top, then 10 along the next level."},
        {"fn": "length_at", "args": {"paths": [[0, 0, 10, 10, 10, 15, 30, 35]], "x": 40}, "expect": 35, "note": "Past the line's end: its length."},
