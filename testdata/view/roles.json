        {"fn": "length_at", "args": {"paths": [[0, 0, 10, 10], [20, 10, 30, 20]], "x": 25}, "expect": 15, "note": "In the second path, from its own start, 10."},
        {"fn": "length_at", "args": {"paths": [[0, 0, 10, 10], [20, 10, 30, 20]], "x": -5}, "expect": 0, "note": "Before the line: its start."},
        {"fn": "length_at", "args": {"paths": [[0, 0, 3, 5, 6, 10]], "x": 1.5}, "expect": 2.5, "note": "Along a sloping segment 3 across and 4 up, 5 long: halfway across is halfway along."}
