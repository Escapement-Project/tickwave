{
  "about": "What each pixel column of a row shows, on real data: identify-swd's SWDIO and SWCLK and the first twelve current samples of verge's energy capture (nA, 100 kHz). Expected states are worked by hand. The two overviews are the ones columns.test.ts's MemorySource cases build and check.",
  "source": "web/src/render/columns.ts",
  "tests": [
    {
      "name": "digital from edges: one edge a column rises or falls where it is",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":1000,"count":13},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377107000},"expect":{"state":["RISE","FALL","RISE","FALL","LOW","RISE","FALL","RISE","HIGH","HIGH","FALL","LOW","RISE"],"at":{"0":0.556,"10":0.078,"12":0.074}}}
      ]
    },
    {
      "name": "digital from edges: two or more edges a column are busy",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377108000},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","RISE"],"at":{"2":0.778}}}
      ]
    },
    {
      "name": "digital from edges: nothing at or past the channel's end",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377105000},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","NONE"]},"note":"The channel ends at 377105000; the edge at 377106074 is in the array but past the end."},
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377106050},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","LOW"]},"note":"Ending at 377106050, inside the last column: the column is low up to the end, and the edge at 377106074, past it in the same column, is not drawn."}
      ]
    },
    {
      "name": "digital from edges: two edges at one tick are busy, at any zoom",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":0,"per":5,"count":8},"edges":{"level":0,"ticks":[10,20,20,30]},"from":0,"to":40},"expect":{"state":["LOW","LOW","RISE","HIGH","BUSY","HIGH","FALL","LOW"]}},
        {"fn":"digital_from_edges","args":{"grid":{"x0":19.5,"per":0.25,"count":4},"edges":{"level":0,"ticks":[10,20,20,30]},"from":0,"to":40},"expect":{"state":["HIGH","HIGH","BUSY","HIGH"]},"note":"A column a quarter of a tick wide: the pair's column alone."}
      ]
    },
    {
      "name": "digital from overview: busy wherever a changing bucket overlaps",
      "rows": [
        {"fn":"digital_from_overview","args":{"grid":{"x0":376701000,"per":3000,"count":7},"overview":{"bucket":4096,"start":376696832,"level":[1,1,1,1,1,1,1],"changes":[0,0,0,0,0,1,1]},"from":376696832,"to":376725504},"expect":{"state":["HIGH","HIGH","HIGH","HIGH","HIGH","BUSY","BUSY"]},"note":"SWCLK's first edges in buckets of 4096 from 376696832: the first edge, 376719436, is in bucket 5 with three more; bucket 6 holds the last two. SWCLK idles high."},
        {"fn":"digital_from_overview","args":{"grid":{"x0":376718000,"per":3000,"count":1},"overview":{"bucket":4096,"start":376696832,"level":[1,1,1,1,1,1,1],"changes":[0,0,0,0,0,1,1]},"from":376696832,"to":376725504},"expect":{"state":["BUSY"]},"note":"[376718000, 376721000) holds no bucket's start, only the tail of bucket 5, which changes."}
      ]
    },
    {
      "name": "digital from overview: a bucket wider than a column spans its columns",
      "rows": [
        {"fn":"digital_from_overview","args":{"grid":{"x0":376713216,"per":1024,"count":12},"overview":{"bucket":4096,"start":376696832,"level":[1,1,1,1,1,1,1],"changes":[0,0,0,0,0,1,1]},"from":376696832,"to":376725504},"expect":{"state":["HIGH","HIGH","HIGH","HIGH","BUSY","BUSY","BUSY","BUSY","BUSY","BUSY","BUSY","BUSY"]},"note":"Four columns a bucket from bucket 4: bucket 4 holds no edge, 5 and 6 change."}
      ]
    },
