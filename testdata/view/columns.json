{
  "about": "What each pixel column of a row shows, on real data: identify-swd's SWDIO and SWCLK and the first twelve current samples of verge's energy capture (nA, 100 kHz). Expected values are worked by hand. The digital overview's density and duty are SWCLK's, worked by hand from its edges in columns.test.ts.",
  "source": "web/src/render/columns.ts",
  "tests": [
    {
      "name": "digital from edges: one edge a column rises or falls where it is",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":1000,"count":13},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377107000},"expect":{"state":["RISE","FALL","RISE","FALL","LOW","RISE","FALL","RISE","HIGH","HIGH","FALL","LOW","RISE"],"at":{"0":0.556,"10":0.078,"12":0.074}}}
      ]
    },
    {
      "name": "digital from edges: two or more edges a column are busy",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377108000},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","RISE"],"at":{"2":0.778}}}
      ]
    },
    {
      "name": "digital from edges: nothing at or past the channel's end",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377105000},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","NONE"]},"note":"The channel ends at 377105000; the edge at 377106074 is in the array but past the end."},
        {"fn":"digital_from_edges","args":{"grid":{"x0":377094000,"per":2000,"count":7},"edges":{"level":0,"ticks":[377094556,377095556,377096556,377097556,377099556,377100556,377101556,377104078,377106074]},"from":377094000,"to":377106050},"expect":{"state":["BUSY","BUSY","RISE","BUSY","HIGH","FALL","LOW"]},"note":"Ending at 377106050, inside the last column: the column is low up to the end, and the edge at 377106074, past it in the same column, is not drawn."}
      ]
