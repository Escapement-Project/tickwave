    {
      "name": "digital from edges: two edges at one tick are busy, at any zoom",
      "rows": [
        {"fn":"digital_from_edges","args":{"grid":{"x0":0,"per":5,"count":8},"edges":{"level":0,"ticks":[10,20,20,30]},"from":0,"to":40},"expect":{"state":["LOW","LOW","RISE","HIGH","BUSY","HIGH","FALL","LOW"]}},
        {"fn":"digital_from_edges","args":{"grid":{"x0":19.5,"per":0.25,"count":4},"edges":{"level":0,"ticks":[10,20,20,30]},"from":0,"to":40},"expect":{"state":["HIGH","HIGH","BUSY","HIGH"]},"note":"A column a quarter of a tick wide: the pair's column alone."}
      ]
    },
    {
      "name": "digital from overview: busy wherever a bucket with an edge overlaps, or buckets at different levels",
      "rows": [
        {"fn":"digital_from_overview","args":{"grid":{"x0":376701000,"per":3000,"count":7},"overview":{"bucket":4096,"start":376696832,"density":[0,0,0,0,0,9,5],"duty":[14,14,14,14,14,10,12]},"from":376696832,"to":376725504},"expect":{"state":["HIGH","HIGH","HIGH","HIGH","HIGH","BUSY","BUSY"]},"note":"SWCLK's first edges in buckets of 4096 from 376696832: the first edge, 376719436, is in bucket 5 with three more, so its density is 9 (4 edges); bucket 6 holds the last two, density 5. SWCLK idles high: bucket 5 is high 2849 of its 4096 ticks, duty 10 (28 x 2849 + 4096 over 8192, 10.2); bucket 6 3596, duty 12 (12.8)."},
        {"fn":"digital_from_overview","args":{"grid":{"x0":376718000,"per":3000,"count":1},"overview":{"bucket":4096,"start":376696832,"density":[0,0,0,0,0,9,5],"duty":[14,14,14,14,14,10,12]},"from":376696832,"to":376725504},"expect":{"state":["BUSY"]},"note":"[376718000, 376721000) holds no bucket's start, only the tail of bucket 5, which changes."},
