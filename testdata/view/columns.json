        {"fn":"analog_from_overview","args":{"grid":{"x0":0,"per":16384,"count":8},"overview":{"bucket":32768,"start":0,"min":[51480,212221,336396,417043],"max":[175990,305817,391567,444567]},"from":0,"to":120000},"expect":{"min":[51480,51480,175990,212221,305817,336396,391567,417043],"max":[175990,175990,305817,305817,391567,391567,444567,444567]},"note":"Two columns a bucket: each pair holds its bucket's range, and the first of the next pair reaches down to it."}
      ]
